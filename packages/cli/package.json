{
  "name": "@visual-architecture/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "visual": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "vitest run"
  },
  "dependencies": {
    "@visual-architecture/analyzer": "workspace:*",
    "@visual-architecture/browser-verifier": "workspace:*",
    "@visual-architecture/exporter": "workspace:*",
    "@visual-architecture/ir": "workspace:*",
    "@visual-architecture/layout": "workspace:*",
    "@visual-architecture/renderer": "workspace:*",
    "@visual-architecture/validator": "workspace:*",
    "@visual-architecture/viewer-runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  }
}
